{
  "name": "@bascik/adapter-cloudflare",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bascikdev/bascik.git",
    "directory": "adapters/cloudflare"
  },
  "description": "Cloudflare Pages and Workers adapter for Bascik",
  "keywords": [
    "bascik",
    "adapter",
    "cloudflare",
    "cloudflare workers",
    "html components",
    "serverless"
  ],
  "homepage": "https://bascik.dev",
  "author": "Collin Thomas",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "cover": "yarn coverage",
    "coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts",
    "prepack": "cp ../../LICENSE LICENSE",
    "prepare": "tsc -p tsconfig.build.json",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "update-coverage": "yarn coverage",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "demo:build": "cd e2e/fixture && bascik --build --target cloudflare",
    "demo:deploy": "cd e2e/fixture/dist/.bascik/cloudflare && wrangler deploy",
    "demo:preview": "cd e2e/fixture/dist/.bascik/cloudflare && wrangler preview",
    "demo:dev": "cd e2e/fixture && bascik --target cloudflare --port 8787"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1"
  },
  "peerDependencies": {
    "@bascik/bascik": "^1.0.0"
  },
  "devDependencies": {
    "@bascik/bascik": "^1.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.1.0",
    "miniflare": "4.20260730.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
