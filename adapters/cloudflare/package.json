{
  "name": "@bascik/adapter-cloudflare",
  "version": "1.0.0-rc.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bascikdev/bascik.git",
    "directory": "adapters/cloudflare"
  },
  "description": "Cloudflare Pages and Workers adapter for Bascik",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cover": "yarn coverage",
    "coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts",
    "prepack": "cp ../../LICENSE LICENSE",
    "prepare": "tsc -p tsconfig.build.json",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "update-coverage": "yarn coverage",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.0"
  },
  "peerDependencies": {
    "@bascik/bascik": "^1.0.0-rc.6"
  },
  "devDependencies": {
    "@bascik/bascik": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "miniflare": "4.20260730.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
