{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist",
    "sourceMap": true,
    // dist/ ships without src/, so the maps carry their own sources.
    "inlineSources": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "lib": ["ES2025"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-helper.ts",
    "e2e",
    "node_modules"
  ]
}
