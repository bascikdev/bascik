{
  "name": "@bascik/language-server",
  "version": "1.0.0-rc.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bascikdev/bascik.git",
    "directory": "lsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Language Server Protocol (LSP) server for Bascik components and scoping diagnostics",
  "keywords": [
    "bascik",
    "language server",
    "lsp",
    "html components",
    "diagnostics",
    "linter"
  ],
  "homepage": "https://bascik.dev",
  "author": "Collin Thomas",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bascik-language-server": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "default": "./dist/check.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:ci": "vitest run --project unit",
    "unit": "vitest run --project unit",
    "linear-time": "vitest run --project linear-time",
    "coverage": "vitest run --project unit --coverage.enabled && node bin/update-coverage.ts",
    "cover": "yarn coverage",
    "update-coverage": "vitest run --project unit --coverage.enabled && node bin/update-coverage.ts"
  },
  "dependencies": {
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0 <7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
