{
  "name": "@bascik/language-server",
  "version": "0.1.0-rc.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bascikdev/bascik.git",
    "directory": "lsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Language Server Protocol (LSP) server for Bascik components and scoping diagnostics",
  "author": "Bascik Contributors",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bascik-language-server": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "unit": "vitest run",
    "coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts",
    "cover": "yarn coverage",
    "update-coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts"
  },
  "dependencies": {
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
