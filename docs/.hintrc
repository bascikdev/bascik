{
  "extends": [
    "development"
  ],
  "hints": {
    "apple-touch-icons": "off",
    "meta-viewport": "off",
    "meta-charset-utf-8": "off",
    "detect-css-reflows/paint": "off",
    "detect-css-reflows/composite": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "scrollbar-width"
        ]
      }
    ]
  },
  "ignoredUrls": [
    {
      "domain": ".*(e2e|dist|test-results|coverage|hint-report).*",
      "hints": [
        "*"
      ]
    }
  ]
}
