{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "rootDir": ".",
    "types": ["node"],
    "lib": ["ES2025"],
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "src/lib/**/*.ts", "e2e/**/*.ts", "bascik.config.ts"],
  "exclude": ["node_modules"]
}
