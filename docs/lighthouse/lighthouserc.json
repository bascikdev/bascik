{
  "ci": {
    "collect": {
      "startServerCommand": "bascik --config lighthouse/bascik.config.ts --server --port 8097",
      "startServerReadyPattern": "Server running at http://localhost:8097",
      "url": [
        "http://localhost:8097/",
        "http://localhost:8097/getting-started",
        "http://localhost:8097/components",
        "http://localhost:8097/search",
        "http://localhost:8097/libraries",
        "http://localhost:8097/sitemap"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "is-crawlable": "off",
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "dom-size-insight": [
              "error",
              {
                "maxNumericValue": 4000
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 51200
              }
            ],
            "forced-reflow-insight": "warn",
            "categories:accessibility": [
              "error",
              {
                "minScore": 1.0
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1.0
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1.0
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/libraries$",
          "assertions": {
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.01
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/sitemap$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
