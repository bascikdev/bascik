{
  "name": "create-bascik",
  "description": "Create a new Bascik project: HTML components with scoped CSS and JS, zero runtime.",
  "keywords": [
    "bascik",
    "create-bascik",
    "html components",
    "scaffold",
    "starter",
    "static site generator"
  ],
  "version": "1.0.0-rc.12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bascikdev/bascik.git",
    "directory": "create"
  },
  "license": "MIT",
  "homepage": "https://bascik.dev",
  "author": "Collin Thomas",
  "type": "module",
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "bin": "dist/index.js",
  "engines": {
    "node": ">=24.21.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "miniflare": "4.20260730.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "test": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts",
    "cover": "yarn coverage",
    "update-coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts"
  }
}
