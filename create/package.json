{
  "name": "create-bascik",
  "description": "Create a new Bascik project: HTML components with scoped CSS and JS, zero runtime.",
  "keywords": [
    "bascik",
    "create-bascik",
    "html components",
    "scaffold",
    "starter",
    "static site generator"
  ],
  "version": "1.0.0-rc.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bascikdev/bascik.git",
    "directory": "create"
  },
  "license": "MIT",
  "homepage": "https://bascik.dev",
  "author": "Collin Thomas",
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "src/",
    "README.md"
  ],
  "bin": "dist/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "([ -d ../skills ] && rm -rf assets/skills && mkdir -p assets && cp -R ../skills assets/skills || true) && tsc -p tsconfig.build.json",
    "prepack": "rm -rf assets/skills && mkdir -p assets && cp -R ../skills assets/skills",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "test": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts",
    "cover": "yarn coverage",
    "update-coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts"
  }
}
