{
  "name": "create-bascik",
  "description": "Create a new Bascik project",
  "version": "1.0.0-rc.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bascikdev/bascik.git",
    "directory": "create"
  },
  "license": "MIT",
  "homepage": "https://bascik.dev",
  "author": "Collin Thomas",
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "src/",
    "README.md"
  ],
  "bin": "dist/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "mkdir -p assets && ([ -f ../docs/src/pages/assets/SKILL.md ] && cp ../docs/src/pages/assets/SKILL.md assets/SKILL.md || true) && tsc -p tsconfig.build.json",
    "prepack": "mkdir -p assets && cp ../docs/src/pages/assets/SKILL.md assets/SKILL.md",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "test": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts",
    "cover": "yarn coverage",
    "update-coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts"
  }
}
