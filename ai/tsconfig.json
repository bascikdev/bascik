{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "demo/src/lib/**/*",
    "demo/src/api/**/*",
    "stress/**/*",
    "e2e/**/*",
    "voice-lab/**/*",
    "live/**/*",
    "playwright*.config.ts"
  ]
}
