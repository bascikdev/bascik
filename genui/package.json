{
  "name": "@bascik/genui",
  "version": "0.1.0",
  "description": "Experimental: generative UI for Bascik. A model streams component tags, Bascik renders them as scoped HTML, and the browser needs no JavaScript.",
  "keywords": [
    "bascik",
    "generative ui",
    "ai",
    "chat",
    "streaming",
    "html components"
  ],
  "bugs": {
    "url": "https://github.com/bascikdev/bascik/issues"
  },
  "homepage": "https://bascik.dev/genui",
  "author": "Collin Thomas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bascikdev/bascik.git",
    "directory": "genui"
  },
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./anthropic": "./src/anthropic.ts",
    "./azure-voice-live": "./src/azure-voice-live.ts",
    "./gemini-live": "./src/gemini-live.ts",
    "./mermaid": "./src/mermaid.ts",
    "./openai": "./src/openai.ts",
    "./openai-responses": "./src/openai-responses.ts",
    "./voice": "./src/voice.ts"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./app": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.js"
      },
      "./anthropic": {
        "types": "./dist/anthropic.d.ts",
        "default": "./dist/anthropic.js"
      },
      "./azure-voice-live": {
        "types": "./dist/azure-voice-live.d.ts",
        "default": "./dist/azure-voice-live.js"
      },
      "./gemini-live": {
        "types": "./dist/gemini-live.d.ts",
        "default": "./dist/gemini-live.js"
      },
      "./mermaid": {
        "types": "./dist/mermaid.d.ts",
        "default": "./dist/mermaid.js"
      },
      "./openai": {
        "types": "./dist/openai.d.ts",
        "default": "./dist/openai.js"
      },
      "./openai-responses": {
        "types": "./dist/openai-responses.d.ts",
        "default": "./dist/openai-responses.js"
      },
      "./voice": {
        "types": "./dist/voice.d.ts",
        "default": "./dist/voice.js"
      }
    }
  },
  "files": [
    "dist/",
    "components/",
    "LICENSE",
    "README.md"
  ],
  "bascik": {
    "components": "./components"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "yarn build && cp ../LICENSE LICENSE",
    "unit": "vitest run --project unit",
    "integration": "vitest run --project integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "cd demo && bascik",
    "demo:build": "cd demo && bascik --build",
    "demo:server": "cd demo && bascik --server",
    "e2e": "playwright test",
    "stress:load": "node stress/load.ts",
    "stress:adherence": "node stress/adherence.ts"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@bascik/bascik": "^1.0.2",
    "beautiful-mermaid": "^1.1.3"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "beautiful-mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@bascik/bascik": "^1.0.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.1",
    "beautiful-mermaid": "^1.1.3",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
