{
  "name": "bascik-vscode",
  "displayName": "Bascik",
  "publisher": "bascik",
  "description": "VS Code support for Bascik component tags and scoping compatibility warnings.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "bascik.html.injection",
        "path": "./syntaxes/bascik-html.tmLanguage.json",
        "injectTo": [
          "text.html.basic"
        ]
      }
    ]
  },
  "scripts": {
    "precompile": "node ../../docs/scripts/generate-compatibility-rules.ts",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "vscode:prepublish": "npm run compile",
    "pretest": "npm run compile",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "unit": "vitest run",
    "e2e": "npm run compile && vscode-test --config .vscode-test.cjs",
    "test": "npm run compile && vscode-test --config .vscode-test.cjs",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage && node bin/update-coverage.ts",
    "cover": "yarn coverage",
    "update-coverage": "vitest run --coverage && node bin/update-coverage.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
