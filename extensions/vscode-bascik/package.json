{
  "name": "bascik-vscode",
  "displayName": "Bascik",
  "publisher": "bascik",
  "description": "Navigate Bascik components and catch scoping, server script, stream, and API route issues as you type.",
  "icon": "icon.png",
  "version": "0.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bascikdev/bascik.git",
    "directory": "extensions/vscode-bascik"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "bascik.html.injection",
        "path": "./syntaxes/bascik-html.tmLanguage.json",
        "injectTo": [
          "text.html"
        ]
      },
      {
        "scopeName": "bascik.html.typescript-script.injection",
        "path": "./syntaxes/bascik-typescript-script.tmLanguage.json",
        "injectTo": [
          "text.html.derivative"
        ],
        "embeddedLanguages": {
          "source.ts": "typescript"
        }
      }
    ],
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/api-routes.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/api-routes-javascript.json"
      }
    ],
    "configuration": {
      "title": "Bascik",
      "properties": {
        "bascik.typescript.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Report TypeScript errors in `<script type=\"text/typescript\">` blocks. Bascik checks them with VS Code's own TypeScript (or the one `#bascik.typescript.path#` names, or the project's), and never bundles one."
        },
        "bascik.typescript.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "An absolute path to a `typescript` package folder (TypeScript 5 or 6) to check `type=\"text/typescript\"` blocks with, instead of VS Code's own. A relative path is not read from the open workspace: like any path that cannot be used, it shows a warning and falls back to VS Code's own. A user setting only: a workspace cannot choose code for the editor to load. TypeScript 7 has no language service and is skipped."
        }
      }
    }
  },
  "scripts": {
    "compile": "node ../../docs/scripts/generate-compatibility-rules.ts && node build.mjs",
    "vscode:prepublish": "npm run compile",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "unit": "vitest run",
    "e2e": "npm run compile && vscode-test --config .vscode-test.cjs",
    "test": "npm run compile && vscode-test --config .vscode-test.cjs",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage && node bin/update-coverage.ts",
    "cover": "yarn coverage",
    "update-coverage": "vitest run --coverage && node bin/update-coverage.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.145.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "tm-grammars": "1.32.22",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vscode-languageclient": "^11.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
