{
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "pkg",
    "create",
    "docs",
    "extensions/vscode-bascik"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "pkg:build": "yarn workspace @bascik/bascik build",
    "pkg:bench": "yarn workspace @bascik/bascik bench",
    "pkg:typecheck": "yarn workspace @bascik/bascik typecheck",
    "pkg:unit": "yarn workspace @bascik/bascik unit",
    "pkg:e2e": "yarn workspace @bascik/bascik e2e",
    "pkg:e2e:dev": "yarn workspace @bascik/bascik e2e:dev",
    "pkg:e2e:prod": "yarn workspace @bascik/bascik e2e:prod",
    "pkg:e2e:prod:http1": "yarn workspace @bascik/bascik e2e:prod:http1",
    "pkg:e2e:prod:http2": "yarn workspace @bascik/bascik e2e:prod:http2",
    "pkg:e2e:all": "yarn pkg:e2e && yarn pkg:e2e:prod",
    "pkg:coverage": "yarn workspace @bascik/bascik coverage",
    "pkg:cover": "yarn pkg:coverage",
    "pkg:test": "yarn workspace @bascik/bascik test",
    "pkg:test:ci": "yarn workspace @bascik/bascik test:ci",
    "pkg:test:coverage": "yarn workspace @bascik/bascik test:coverage",
    "create:build": "yarn workspace create-bascik build",
    "create:prepack": "yarn workspace create-bascik prepack",
    "create:test-site": "yarn create:build && node create/dist/index.js my-site -y",
    "create:typecheck": "yarn workspace create-bascik typecheck",
    "create:unit": "yarn workspace create-bascik unit",
    "create:coverage": "yarn workspace create-bascik coverage",
    "create:cover": "yarn create:coverage",
    "create:test": "yarn workspace create-bascik test",
    "create:test:ci": "yarn workspace create-bascik test:ci",
    "create:update-coverage": "yarn create:coverage",
    "docs:build": "yarn workspace bascik-docs build",
    "docs:dev": "yarn workspace bascik-docs dev",
    "docs:preview": "yarn workspace bascik-docs preview",
    "docs:typecheck": "yarn workspace bascik-docs typecheck",
    "docs:unit": "yarn workspace bascik-docs unit",
    "docs:e2e": "yarn workspace bascik-docs e2e",
    "docs:lighthouse": "yarn workspace bascik-docs lighthouse",
    "docs:lighthouse:all": "yarn workspace bascik-docs lighthouse:all",
    "docs:coverage": "yarn workspace bascik-docs coverage",
    "docs:cover": "yarn docs:coverage",
    "docs:test": "yarn workspace bascik-docs test",
    "docs:update-coverage": "yarn workspace @bascik/bascik update-coverage",
    "docs:update-e2e-coverage": "yarn workspace @bascik/bascik update-e2e-coverage",
    "docs:update-scripts-coverage": "yarn workspace bascik-docs update-coverage",
    "ext:compile": "yarn workspace bascik-vscode compile",
    "ext:typecheck": "yarn workspace bascik-vscode typecheck",
    "ext:unit": "yarn workspace bascik-vscode unit",
    "ext:e2e": "yarn workspace bascik-vscode e2e",
    "ext:coverage": "yarn workspace bascik-vscode coverage",
    "ext:cover": "yarn ext:coverage",
    "ext:test": "yarn workspace bascik-vscode test",
    "ext:update-coverage": "yarn ext:coverage",
    "check:spelling": "codespell -L teY,directroy,scirpt,erorr,buld --builtin \"clear,rare,en-GB_to_en-US\" pkg/src docs/content docs/src create/src",
    "check:standards": "npx hint docs/src/pages",
    "check:security": "semgrep --error --config p/default",
    "check:all": "yarn check:spelling && yarn check:standards",
    "typecheck:all": "yarn pkg:typecheck && yarn create:typecheck && yarn docs:typecheck && yarn ext:typecheck",
    "unit:all": "yarn pkg:unit && yarn create:unit && yarn docs:unit && yarn ext:unit",
    "e2e:all": "yarn pkg:e2e:all && yarn docs:e2e",
    "coverage:all": "yarn pkg:coverage && yarn create:coverage && yarn docs:coverage && yarn ext:coverage",
    "cover:all": "yarn coverage:all",
    "update-coverage:all": "yarn coverage:all",
    "test:all": "yarn typecheck:all && yarn check:all && yarn unit:all && yarn e2e:all && yarn docs:lighthouse"
  }
}
