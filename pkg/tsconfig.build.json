{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist",
    "sourceMap": true,
    "removeComments": false,
    // Allow implicit any for the initial migration — add types incrementally
    // 'yarn pkg:typecheck' (noEmit, strict) is the authoritative type-check pass
    "noImplicitAny": false,
    "strictNullChecks": false,
    "lib": ["ES2025"]
  },
  "include": ["src/**/*.ts"],
  // Test-only sources stay out of dist/, which ships to every install
  // (src/lib/package-contents.integration.test.ts).
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-helper.ts",
    "src/**/*.fixture.ts",
    "src/**/*.fixtures.ts",
    "src/**/__fixtures__/**",
    "src/**/test-fixtures/**",
    "src/lib/build-fixtures.ts",
    "node_modules"
  ]
}
