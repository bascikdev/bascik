{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist",
    "sourceMap": true,
    "removeComments": false,
    // Allow implicit any for the initial migration — add types incrementally
    // 'yarn pkg:typecheck' (noEmit, strict) is the authoritative type-check pass
    "noImplicitAny": false,
    "strictNullChecks": false,
    "lib": ["ES2025"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "node_modules"]
}
