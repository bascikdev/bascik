{
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true, 
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "rootDir": "..",
    "types": ["node"],
    "lib": ["ES2025", "DOM"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "../bascik.config.ts"]
}
