# Runtime exec-producer state (generation counter and gate arm) written by
# scripts/generator.mjs during E2E runs. Not source; regenerated each run.
scripts/.generation
scripts/.armed-gate
# Dev server log written by scripts/run-dev-logged.mjs (the dev-exec Playwright
# webServer wrapper) so tests can assert which pages a producer completion
# recompiled.
.dev-server.log

# Local dev server artifacts are already ignored repo-wide (dist, node_modules),
# kept here for explicitness.
dist/
node_modules/