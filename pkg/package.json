{
  "name": "@bascik/bascik",
  "description": "A Web Framework",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://bascik.dev",
  "author": "Collin Thomas",
  "type": "module",
  "types": "./dist/lib/defineConfig.d.ts",
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": "bin/bascik.js",
  "exports": {
    ".": {
      "types": "./dist/lib/defineConfig.d.ts",
      "default": "./dist/lib/defineConfig.js"
    },
    "./config": {
      "types": "./dist/lib/defineConfig.d.ts",
      "default": "./dist/lib/defineConfig.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "0x": "^6.0.0",
    "@mdn/browser-compat-data": "^8.0.13",
    "@playwright/test": "^1.62.0",
    "@types/css-tree": "^3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@webref/css": "^8.7.3",
    "@webref/elements": "^2.8.0",
    "@webref/idl": "^3.83.0",
    "autoprefixer": "^10.5.4",
    "c8": "^12.0.0",
    "clinic": "^13.0.0",
    "css-tree": "^3.2.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.9.0",
    "postcss": "^8.5.26",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "web-features": "^3.36.0",
    "webidl2": "^24.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../LICENSE LICENSE",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "unit": "vitest run",
    "test": "vitest",
    "test:ci": "vitest run --coverage.enabled --coverage.reporter='text-summary'",
    "test:coverage": "vitest run --coverage.enabled",
    "e2e": "playwright test --config e2e/playwright.config.ts --reporter=line",
    "e2e:dev": "playwright test --config e2e/playwright.dev.config.ts --reporter=line",
    "e2e:dev:exec": "playwright test --config e2e/playwright.dev-exec.config.ts --reporter=line && playwright test --config e2e/playwright.dev-exec-gated.config.ts --reporter=line",
    "e2e:prod": "yarn e2e:prod:http1 && yarn e2e:prod:http2",
    "e2e:prod:http1": "playwright test --config e2e/playwright.server.config.ts --reporter=line",
    "e2e:prod:http2": "playwright test --config e2e/playwright.server-http2.config.ts --reporter=line",
    "e2e:cloudflare": "playwright test --config e2e/playwright.cloudflare.config.ts --reporter=line",
    "e2e:all": "yarn e2e && yarn e2e:dev && yarn e2e:prod && yarn e2e:cloudflare",
    "coverage": "yarn update-coverage && yarn update-e2e-coverage",
    "cover": "yarn coverage",
    "update-coverage": "vitest run --coverage.enabled && node bin/update-coverage.ts",
    "update-e2e-coverage": "node bin/update-e2e-coverage.ts",
    "bench": "vitest bench",
    "dev": "bascik",
    "profile:workload": "node bench/profile-workload.ts"
  }
}
