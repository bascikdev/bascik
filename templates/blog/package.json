{
  "name": "bascik-blog-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A complete blog starter for Bascik: Markdown posts, tags, paginated archive, Atom feed, canonical and Open Graph metadata, responsive images, and a 404 page.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bascik",
    "build": "bascik --build",
    "serve": "bascik --server",
    "check": "bascik --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bascik/bascik": "^1.0.0-rc.2",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "marked": "^18.0.14",
    "prismjs": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "~24.13.6",
    "@types/prismjs": "^1.26.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
